<language-addon>
    <addon-name>chronos</addon-name>
    <language-name>xul/html</language-name>

    <stylesheet href="/static/css/style.css" type="text/css"/>

    <component>
        <component-name>headerseditor</component-name>
        <component-class>tools.dynamia.chronos.ui.HeadersEditor</component-class>
        <extends>div</extends>
        <annotation>
            <annotation-name>default-bind</annotation-name>
            <property-name>value</property-name>
            <attribute>
                <attribute-name>access</attribute-name>
                <attribute-value>both</attribute-value>
            </attribute>
            <attribute>
                <attribute-name>save-when</attribute-name>
                <attribute-value>self.onChange</attribute-value>
            </attribute>
        </annotation>
        <annotation>
            <annotation-name>ZKBIND</annotation-name>
            <property-name>value</property-name>
            <attribute>
                <attribute-name>ACCESS</attribute-name>
                <attribute-value>both</attribute-value>
            </attribute>
            <attribute>
                <attribute-name>SAVE_EVENT</attribute-name>
                <attribute-value>onChange</attribute-value>
            </attribute>
        </annotation>
    </component>
</language-addon>
